{
  "name": "traintrace",
  "version": "1.3.0-rc.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --mode local-ai --outDir dist-local",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env.local dist-server/index.js",
    "verify:deepseek": "node --env-file-if-exists=.env.local dist-server/verify.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.0",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@10.17.1"
}
