    "guidance": {
      "title": "悬垂举腿",
      "goal": "腹部，配合骨盆与躯干控制。",
      "cues": [
        "先选择自己能够稳定支撑的悬垂方式。",
        "上抬时集中控制腹部卷起与收紧。",
        "控制下落，保留一点幅度，不一下沉到底。"
      ],
      "errors": [
        "下放太多、髋部或腿前侧先吃力 → 减小下落幅度。",
        "做不到当前难度 → 按能力选择悬垂带或支撑版本。"
      ],
      "tips": [
        "原卡包含不同呼吸模式；这里不要求屏气，也不把某一种模式作为统一标准。"
      ]
    }
  },
