    ],
    "guidance": {
      "title": "双杠臂屈伸（胸部侧重）",
      "goal": "胸部，原卡侧重下胸与胸外沿。",
      "cues": [
        "挺胸并稍微屈髋，让重心保持微微前倾。",
        "上下过程中保持躯干位置，不突然直起身体。",
        "在能维持胸部收紧的幅度内完成。"
      ],
      "errors": [
        "身体直起、重心改变 → 回到微前倾的位置。",
        "过程中躯干与胸部松掉 → 减小幅度，先保持控制。"
      ],
      "tips": [
        "此卡是胸部侧重的自重双杠版本，不套用到凳上或负重臂屈伸。"
      ]
    }
  },
  {
    "id": "ACT-005",
    "title": "坐姿器械推胸（平推）",
    "type": "action",
    "status": "reviewed",
    "sourceFile": "坐姿器械推胸.md",
