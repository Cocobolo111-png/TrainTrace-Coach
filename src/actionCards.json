    ],
    "guidance": {
      "title": "坐姿哑铃推举",
      "goal": "三角肌，配合坐姿推举练习。",
      "cues": [
        "靠背调整到腰部能够贴住的位置。",
        "下放到眼睛附近、仍能控制的位置，再向上推。",
        "推起时保留控制，不靠身体后仰或顶腰完成。"
      ],
      "errors": [
        "顶腰、后仰借力 → 回到能保持坐姿的重量。",
        "下放过深而失控 → 减小幅度。",
        "推到完全锁直、失去张力 → 保留一点控制空间。"
      ],
      "tips": [
        "起铃与收铃时让哑铃靠近身体，借腿接送，不从地面硬提重哑铃。"
      ]
    }
  },
