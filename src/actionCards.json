    ],
    "guidance": {
      "title": "坐姿器械平推",
      "goal": "胸肌，以平推时的胸部收紧为重点。",
      "cues": [
        "坐稳，让腰背贴住靠背，再准备推起。",
        "推到胸部收紧即可，不必刻意把手肘锁死。",
        "还原时保持躯干位置，不靠拱腰把重量推出。"
      ],
      "errors": [
        "腰离开靠背 → 减轻重量，先保持坐姿稳定。",
        "为了推得更远而锁死手肘 → 回到胸部能持续收紧的幅度。"
      ],
      "tips": [
        "这是器械平推的指导，不直接套用到杠铃或哑铃卧推。"
      ]
    }
  },
