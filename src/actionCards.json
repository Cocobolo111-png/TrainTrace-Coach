  {
    "id": "ACT-016",
    "title": "坐姿哑铃推举",
    "type": "action",
    "status": "reviewed",
    "sourceFile": "坐姿哑铃推举.md",
    "sha256": "2fb6e8aaa575676cfa41e364ad42939b02ea49b22a259aeeb5c34245e7f7ab43",
